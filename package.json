{
  "name": "dsh-bili-notify",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: read bilibili notifications (@ mentions and replies) and video comments; optionally post a reply.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.png",
    "README*.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
